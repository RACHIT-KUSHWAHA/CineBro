# CineBro Production Configuration Template
# Copy this to .env and fill in your actual values

# ═══════════════════════════════════════════════════════════
# TELEGRAM API CREDENTIALS (Required)
# ═══════════════════════════════════════════════════════════

# Get from https://my.telegram.org/apps
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Bot token (get from @BotFather)
BOT_TOKEN=123456789:ABCDEFGHIJKLMnopqrstuvwxyz1234567890

# Session string (for userbot indexing, optional)
# Generate: python generate_session.py
SESSION_STRING=your_session_string_here

# ═══════════════════════════════════════════════════════════
# MONGODB CONFIGURATION
# ═══════════════════════════════════════════════════════════

# MongoDB connection URI
# For local: mongodb://localhost:27017
# For cloud: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true
MONGO_URI=mongodb://localhost:27017

# Database name
DB_NAME=MoviesBot

# ═══════════════════════════════════════════════════════════
# ADMIN & OWNER CONFIGURATION
# ═══════════════════════════════════════════════════════════

# Your Telegram user ID (for admin commands)
ADMIN_ID=123456789

# ═══════════════════════════════════════════════════════════
# CHANNEL CONFIGURATION (for Userbot/Indexer)
# ═══════════════════════════════════════════════════════════

# Channel to index movies from
STORAGE_CHANNEL=-1001234567890

# Database channel for auto-indexer (Auto-Indexer will listen here)
DATABASE_CHANNEL_ID=-1001234567890

# Backup/secondary channel for cloning files
BACKUP_CHANNEL=-1001234567890

# ═══════════════════════════════════════════════════════════
# LOGGING & MONITORING
# ═══════════════════════════════════════════════════════════

# Channel to send search logs (optional)
LOG_CHANNEL_ID=-1001234567890

# ═══════════════════════════════════════════════════════════
# SUPPORT & LINKS
# ═══════════════════════════════════════════════════════════

# Support group invite link
SUPPORT_GROUP_LINK=https://t.me/your_support_group

# Owner profile link
OWNER_PROFILE_LINK=https://t.me/your_username

# Support group ID (for direct links, optional)
SUPPORT_GROUP_ID=-1001234567890

# ═══════════════════════════════════════════════════════════
# PRODUCTION SETTINGS
# ═══════════════════════════════════════════════════════════

# Rate limit: max searches per minute per user
# Default: 5 (do not set lower)
RATE_LIMIT_PER_MINUTE=5

# Auto-delete delay in seconds
# Default: 1800 (30 minutes, REQUIRED for copyright compliance)
AUTO_DELETE_DELAY_SECONDS=1800

# Page size for search results
# Default: 10 (do not increase beyond 15)
SEARCH_PAGE_SIZE=10

# ═══════════════════════════════════════════════════════════
# NOTES
# ═══════════════════════════════════════════════════════════

# 1. Keep this file secure (add to .gitignore)
# 2. Never commit real values to repository
# 3. Use strong MongoDB passwords
# 4. Rotate API keys periodically
# 5. Monitor logs for errors/abuse
# 6. Test all features before production deployment

# Validate configuration:
# python -c "
# import config
# print('✅ Configuration loaded successfully')
# print(f'Bot Token: {config.BOT_TOKEN[:10]}...')
# print(f'Admin ID: {config.ADMIN_ID}')
